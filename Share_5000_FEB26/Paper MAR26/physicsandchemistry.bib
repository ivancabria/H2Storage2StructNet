@article{GMJ+98,
      author= {J J Gallet and J M Mariot and L Journel and C F Hague
              and J P Kappler and S Schmerber and D J Singh and G
                  Krill and J Goulon and  A Rogalev},
      title= {Rh 4d spin polarization of valence states in Co-Rh},
      journal=prb,
      volume = {57},
      pages  = {7835},
      year   = {1998},
      addendum = {X-ray fluorescence spectra involving Rh valence
 states in Co-Rh-based alloys
 have been recorded using circularly polarized photons from the Helios II
 helical undulator at ESRF. Magnetic circular dichroism in the X-ray emission
 (XEMCD) is observed. To help identify the significance of the XEMCD signal,
 spin-polarized density functional electronic structure calculations for
 Co3Rh have been performed using the general potential linearized augmented
 plane wave method and appropriate transition matrix elements included to
 calculate spin-polarized spectra. The theoretical spin polarization is in
 excellent agreement with experiment in so far as both reveal that, at medium
 sites, polarization is concentrated close to the fermi edge. The width of
 the peak in spin polarization can be varied by substituting Ru or Pd for Rh.
 The size of the change is discussed in relation to the measured
 magnetization and interpreted with the help of a generalized Slater-Pauling
 approach [A. R. Williams et al., IEEE Trans. Magn. MAG-19, 1983 (1983)].}
}

