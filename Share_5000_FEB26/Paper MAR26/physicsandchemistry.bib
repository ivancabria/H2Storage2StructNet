   author    = {J Forstreuter and L Steinbeck and M Richter and H Eschrig},
   title     = {Density-functional calculations for rare-earth atoms and ions},
   journal   = prb,
   year      = {1997},
   volume    = {55},
   pages     = {9415},
   addendum  = {
Relativistic local-spin-density (RLSD) and self-interaction-corrected (SIC) RLSD calculations were performed for
the whole series of the rare-earth elements. Ionization potentials and radial expectation values with 4f wave functions
were calculated. Improvement on nearly all quantities is found for SIC calculations. Comparison with other calculational
methods shows that for a description of rare-earth elements SIC-RLSD competes well in accuracy with all of them,
including the most accurate quantum-chemical approach. This is important since the SIC calculation has the advantage
of being suited for a description of localized f states in solids with a comparatively moderate effort.}
}

@article{TSG97,
   author    = {W M Temmerman and Z Szotek and G A Gehring},
   title     = {Self-Interaction Free Relativistic Local Spin Density
                Approximation: Equivalent of Hund's Rules in gamma -Ce},
   journal   = prl,
   year      = {1997},
   volume    = {79},
   pages     = {3970},
   addendum  = {
In this Letter we present an ab initio, density functional theory, justification for the validity of Hund's type of rules in the
solid state with localized electrons. We demonstrate that an orbital dependent functional, such as the
self-interaction-corrected local spin density, is capable of fully describing the localized nature of the f state, so that all
three Hund's rules are fulfilled. We argue this on the basis of linear-muffin-tin-orbital calculations in the
atomic-sphere approximation for the gamma phase of Ce.}
}



@article{BTS+98,
   author    = {S V Beiden and W M Temmerman and Z Szotek and
                G A Gehring and G M Stocks and Yang Wang and
                D M C Nicholson and  W A Shelton and H Ebert},
   title     = {Real Space Approach to the calculation of Magnetocrystalline
Anisotropy in Metals},
   journal   = prb,
   year      = {1998},
   volume    = {57},
   pages     = {14247},
   addendum  = {RS-SPR-KKR,
We have implemented the fully relativistic and spin-polarized extension of the locally self-consistent
multiple-scattering method. We have calculated the spin and orbital magnetic moments and magnetocrystalline
anisotropy energy of Fe, Ni, and Co in the face-centered-cubic (fcc) and hexagonal-close-packed (hcp) crystal
structures. We have obtained fast convergence of these quantities in real space. Moreover, these results compare
favorably with the results of conventional k-space methods}
}



