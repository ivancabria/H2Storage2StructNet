}



@article{PES+98,
        author= {V Popescu and H Ebert and L Szunyogh and U Pustogowa
                and P Weinberger},
        title = {Theoretical investigations of spin-resolved appearance
    potential spectroscopy for Fe/Cu(001) overlayers},
        journal=pmb,
        volume= {78},
        pages = {497},
        year = {1998},
   addendum  = { We present spin-resolved appearance potential spectroscopy (APS) calculations at the 2P3/2 edge of Fe in the high-moment ferromagnetic phase of fcc Fe/Cu(001)
overlayers, based on a single-particle description of the underlying electronic structure. Within the framework of the real-space Korringa-Kohn-Rostoker method,
the spectra were calculated in a layer-resolved mode. This allows one to investigate in detail the dependence of the total APS signal-a superposition of weighted
layer-signals-as a function of the Fe overlayer thickness.

