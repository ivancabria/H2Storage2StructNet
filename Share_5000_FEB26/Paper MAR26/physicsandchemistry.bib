@article{HZE+98,
   author    = {T Huhne and C Zecha and H Ebert and P H Dederichs and R Zeller},
   title     = {The full-potential spin-polarized relativistic
                Korringa-Kohn-Rostoker method --
                implementation and application to bcc-Fe, fcc-Co and fcc-Ni},
   journal   = prb,
   year      = {1998},
   volume    = {58},
   pages     = {10236},
   addendum  = {The full-potential spin-polarized relativistic Korringa-Kohn-Rostoker (FP-SPR-KKR) method of band-structure calculation has been implemented in a
self-consistent way. This scheme deals with the nonspherical potential as well as spin polarization and all relativistic effects on the same level. Technical details of
this approach as well as its formal extension to account for the so-called orbital polarization (OP) mechanism are described in some detail. Results of corresponding
applications to the elemental ferromagnets bcc-Fe, fcc-Co, and fcc-Ni are presented with an emphasis on the consequences of nonspherical and OP-potential
terms.

CC   A7125P Band structure of crystalline metals; A7125C Techniques of
     band-structure calculation (general theory, applications of group theory,
     analytic continuation, etc.); A7550B Ferromagnetism of Fe and its alloys;
     A7550C Ferromagnetism of other metals

CT   BAND STRUCTURE; COBALT; FERROMAGNETIC MATERIALS; IRON; KKR CALCULATIONS;
     NICKEL; RELATIVISTIC BAND STRUCTURE CALCULATIONS; SCF CALCULATIONS

ST   full-potential spin-polarized relativistic Korringa-Kohn-Rostoker method;
     bcc Fe; fcc Co; fcc Ni; FP-SPR-KKR method; band structure calculation;
     self-consistent method; nonspherical potential; spin polarization;
     relativistic effects; orbital polarization; elemental ferromagnets;
     OP-potential terms; Fe; Co; Ni}
}

