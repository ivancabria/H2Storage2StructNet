@article{FBB+99,
   author    = {T Funk and E Beck and W D Brewer and C Bobek and E Klein},
   title     = {Systematics of the nuclear spin-lattice relaxation rates of transition-element impurities in Fe},
   journal   = jmmm,
   year      = {1999},
   volume    = {195},
   pages     = {406},
   addendum  = {We discuss the systematics of the nuclear spin-lattice relaxation
rates of 3d-, 4d-, and 5d-series elements as dilute impurities in iron, and give
a critical selection of experimental data. We also report a new value for the
important case of Fe$Fe$. Many of the earlier experimental results were obtained
by our group using the method of thermal cycling on oriented nuclei (TCON). A
comparison with available ab initio calculations reveals that the latter show
increasing deviations from the experimental results for the heavier transition-element
series, but do reproduce well the observed systematic trends including the maxima
near the middle of each series. We discuss possible reasons for the discrepancies
and suggest some further experiments and calculations.}
}

@article{BDK93,
   author    = {C Bobek and R Dullenbacher and E Klein},
   title     = {Nuclear spin lattice relaxation of $^{186}Re$Fe and $^{182}Ta$Fe: the role of spin wave mechanism},
   journal   = hi,
   year      = {1993},
   volume    = {77},
   pages     = {327},
   addendum  = {Using the thermal cycling method, the nuclear spin lattice relaxation of $^{186}Re$Fe and $^{182}Ta$Fe has been measured in polarizing fields of 0.1 to 1.2 T. The results for the relation
    constants in the high-field limit are 87(2) and 470(10) ms K, respectively. The relaxation rates are
    about a factor of three larger than expected from ab initio calculations. It is proposed to interpret
    this discrepancy as proof for a significant spin wave contribution to the relaxation.}
}

@article{BBFK98,
   author    = {E Beck and W D Brewer and T Funk and E Klein},
   title     = {Nuclear spin-lattice relaxation rates of Ni and Ru in Fe },
   journal   = aujp,
   year      = {1998},
   volume    = {51},
   pages     = {267-279},
   addendum  = {We have determined the nuclear spin-lattice relaxation (SLR) rates of Ni and Ru as dilute impurities in iron using the method of thermal cycling on oriented nuclei.
       The samples were prepared by recoil implantation from the heavy ion reactions used to produce the radioactive Ni and Ru isotopes employed in the measurements.
       In the 3d impurity series, only Sc, Ti, and Cu remain to complete the systematics of the SLR in iron host; in the 4d series, values for Zr and Pd are still missing and
       the datum for Rh has a large experimental uncertainty. We discuss the comparison with theory and with other experimental results}
}

@article{BBF+98,
   author    = {E Beck and W D Brewer and T Funk and C Bobek and E Klein},
   title     = {Spin-lattice relaxation rates of Os and other 5d elements in Fe },
   journal   = aujp,
   year      = {1998},
   volume    = {51},
   pages     = {281-293},
   addendum  = {We give final results for the nuclear spin-lattice relaxation (SLR) rates of 5d series elements as dilute impurities in iron using the method of thermal cycling on
       oriented nuclei. In this report, we emphasise some aspects of the analysis of the relaxation curves, especially for Os and Au impurities. A comparison of the results
       with theory is given. }
}

