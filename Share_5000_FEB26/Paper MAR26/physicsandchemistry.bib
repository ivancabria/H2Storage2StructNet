}



@article{JTPE98,
   author    = {A C Jenkins and W M Temmerman and V Popescu and H Ebert},
   title     = {Magnetic circular dichroism in Gd metal: the L edges},
   journal   = pmb,
   year      = {1998},
   volume    = {78},
   pages     = {527},
   addendum  = {The magnetic and structural properties of bulk hcp Gd and of its (0001) surface have been studied using the linear-muffin-tin-orbital method with the atomic-sphere
approximation. This method has been used within the framework of the generalised gradient approximation (GGA) of Perdew, Burke and Ernzerhof. Inclusion of the
GGA is found to be necessary for the occurrence of layerwise ferromagnetic coupling. The influence of the structural properties on the X-ray absorption and dichroic
spectra at the various L edges is discussed. In particular the dichroic signal of the atomic layers near the surface is found to be sensitive to the relaxation of the
surface layer.

