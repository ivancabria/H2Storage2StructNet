@article{BGK+97,
      author = { M Belakhovsky and B Gilles and C Boeglin and P Kamp
                 and A Marty and J B Goedkoop and N B Brookes},
      title = {Induced copper magnetism in Permalloy-copper bilayers},
      journal=jdp,
      volume = {7},
      pages  = {C2-443},
      year   = {1997},
      addendum = {We have performed dichroic measurements at the
 L2,3 edges of the 3 elements Ni, Fe and Cu on the ESRF beam line
 BL26 (<>). The samples were
 Ni0.8Fe0.2/Cu bilayers prepared by molecular beam epitaxy. The Cu spectra
 show a dichroic effect, which decreases regularly as a function of Cu spacer
 thickness. A significant orbital contribution is present, and the
 application of the sum rules leads to a ratio of orbital to spin magnetic
 moments for the Cu d electrons:ML/MS=0.14+or-0.01, 0.21+or-0.02,
 0.38+or-0.03 (respectively for .2, .4 and .6 nm of Cu). These measurements,
 which contrast with the CoCu case, also exemplify the high potential of ESRF
 for XMCD experiments (few atomic layers and tiny induced dichroism).}
}




