@misc{f90program,
   author = {I. Cabria},
   title = {Discrete Methods of Gas Storage, dmgs},
   howpublished = {We have implemented several methods to solve the 
   one-dimensional {S}chr\"odinger equation: Second derivative, Numerov, 
   Discrete Plane Waves ({DPW}), and {R}ayleigh-{R}itz-{G}alerkin ({RRG}) 
   methods. We have tested all of them against well known potentials such 
   as {C}oulomb, harmonic oscillator, quartic, {Y}ukawa, $e^{-z}$, and 
   {L}ennard-{J}ones (Mateo FG, Z\'u$\tilde{n}$iga J, Requena A, Hidalgo 
   A. Energy eigenvalues for Lennard-Jones potentials using the 
   hypervirial perturbative method. J. Phys. B: Atom. Molec. Phys. 1990; 
   23:2771). The fastest method was the {DPW} one and, therefore, we have 
   used this method to solve the slitpore potential. 1000 basis functions 
   are enough to reach a good convergence.},
   year      = {2007},
}

