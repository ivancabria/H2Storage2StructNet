@article{SJ72,
   author    = {J C Slater and K H Johnson},
   title     = {Self-consistent-field X alpha cluster method for polyatomic molecules and solids},
   journal   = prb,
   year      = {1972},
   volume    = {5},
   pages     = {844},
   addendum  = {X-alpha MST
The one-electron Schrodinger equation is set up for a so-called 'muffin-tin' approximation to the true potential. Once the
eigenfunctions and eigenvalues of this problem are determined, one assumes that the orbitals of lowest eigenvalue are occupied,
up to a Fermi level. From the resulting charge densities, one can compute a total energy, using a statistical approximation for
the exchange correlation. This approximation has an undetermined factor alpha (whence the name X alpha method). The spin
orbitals and occupation numbers are varied to minimize this total energy, resulting in one-electron equations. The value of alpha
for an isolated atom is determined by requiring that the total energy, using the statistical approximation, should equal the
precise Hartree-Fock energy. This leads to very accurate spin orbitals. In a molecule or crystal, one uses the alpha 's
characteristic of the various atoms within the atomic spheres, and a suitable average in the region between. The method is
applied to computer programs for self-consistent calculations on SO4-2, ClO4-, MnO4- and SF6; calculation of optical
transition frequencies; gamma -ray absorption and magnetic problems. Unlike most SCF methods, long-range correlation is
automatically included.

CC   A3120 Specific calculations and results; A3320R X-ray spectra; A3320
     Molecular spectra grouped by wavelength ranges; A7125 Nonlocalized
     single-particle electronic states

CT   BAND STRUCTURE; CRYSTAL FIELD THEORY; MAGNETIC PROPERTIES OF
     SUBSTANCES; MOLECULAR ELECTRONIC STRUCTURE; X-RAY ABSORPTION SPECTRA

ST   selfconsistent field cluster method; one electron Schrodinger
     equation; muffin tin approximation; band structure; polyatomic
     molecules; solids; Fermi level; total energy; exchange correlation;
     spin orbitals; occupation numbers; MnO4-; Sf6; SO4-2; ClO4-; optical
     transition frequencies; X-ray absorption; magnetic problems
}
}



@article{SDM95,
   author    = {I V Solovyev and P H Dederichs and I Mertig},
   title     = {Origin of orbital magnetization and magnetocrystalline anisotropy
                in TX ordered alloys (where T=Fe,Co and X=Pd,Pt)},
   journal   = prb,
   year      = {1995},
   volume    = {52},
   pages     = {13419},
   OPTnote   = {anisotropy, spin-orbit, relativistic, alloys, model},
   addendum  = {We present a method to calculate the magnetic anisotropy parameters which is based on a perturbative treatment of the spin-orbit interaction and a
Green's function technique in real space. It allows us to interpret the magnetocrystalline anisotropy energy (MAE) in terms of interatomic
interactions in the crystal. The method is applied to analyze orbital magnetism and MAE in TX ordered alloys (T=Fe,Co and X=Pd,Pt). The
convergence of the orbital moments and MAE in real space and its relation to the problems of Brillouin-zone integration and of oscillatory behavior of
MAE as a function of band filling are discussed. A comparison with results obtained by other methods is also given.

CC   A7530G Magnetic anisotropy; A7560E Magnetization curves, hysteresis,
     Barkhausen and related effects; A7170E Spin-orbit coupling, Zeeman,
     Stark and strain splitting (condensed matter); A7550B Ferromagnetism
     of Fe and its alloys; A7550C Ferromagnetism of other metals

CT   BRILLOUIN ZONES; COBALT ALLOYS; FERROMAGNETIC MATERIALS; GREEN'S
     FUNCTION METHODS; IRON ALLOYS; MAGNETIC ANISOTROPY; MAGNETISATION;
     PALLADIUM ALLOYS; PLATINUM ALLOYS; SPIN-ORBIT INTERACTIONS

ST   orbital magnetization; magnetocrystalline anisotropy; FePd; FePt;
     CoPd; CoPt; spin-orbit interaction; Green's function technique;
     interatomic interactions; orbital magnetism; Brillouin-zone
     integration; band filling
}
}

@article{DREW97,
   author    = {A Delin and P Ravindran and O Eriksson and J M Wills},
   title     = {Full-potential optical calculations of lead chalcogenides},
   journal   = ijqc,
   year      = {1997},
   volume    = {69},
   pages     = {349},
   addendum  = {We report on ab initio calculations of the optical properties of the lead
chalcogenides PbS, PbSe, and PbTe performed with a relativistic
full-potential linear muffin-tin orbital method within the local density
approximation. Our calculated spectra are in excellent agreement with recent
ellipsometry measurements. The origin of the peaks in the spectra is
discussed, as well as the effects of increasing the chalcogen atomic number.

