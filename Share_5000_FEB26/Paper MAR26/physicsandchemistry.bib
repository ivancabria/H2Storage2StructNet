@article{mrs+80,
   author    = {L Mattera and R Rosatelli and C Salvo and F Tommasini and U Valbusa and G Vidali},
   title     = {Selective adsorption of $^1${H}$_2$ and $^2${H}$_2$ on the (0001) graphite surface},
   journal   = ss,
   year      = {1980},
   volume    = { 93},
   pages     = {515-525},
   addendum     = {Abstract
Scattering of 1H2 and 2H2 from a (0001) graphite surface at 100 K has been performed to study the laterally averaged molecule-surface interaction potential. The bound state spectrum has been determined by selective adsorption measurements. Energy levels at 1.46, 3.61, 7.96, 15.33, 26.43, 41.61 meV for 1H2 and at 1.93, 3.78, 6.37, 10.0, 15.4, 23.1 meV for 2H2 were detected with an experimental accuracy of 0.25 meV. The two lowest levels for 2H2 could not be observed in our experimental conditions. The experimental energy levels are in excellent agreement with those calculated for the potential with . A comparison with the theoretical model proposed by Crowell [1] to describe the interaction of non polar molecules with graphite has been carried out. Improvements to the Crowell model taking into account either higher order dispersion terms or the exponential behaviour of the repulsive interaction, are discussed.},
   addendum  = {Experimental lowest energy of H2 physisorbed on graphite surface: -41.61 meV with an
experimental accuracy of 0.25 meV}
}



