@misc{movetargets12,
   author       = {{Advanced Research Projects Agency - Energy, Department 
   of Energy}},
   title        = {{M}ethane {O}pportunities for {V}ehicular {E}nergy {(MOVE)} 
   {P}rogram {O}verview},
   howpublished = {http://arpa-e.energy.gov/sites/default/files/documents/files/MOVE\_ProgramOverview.pdf},
   year         = {2012},
   note         = {{Accessed January 2, 2026}},
   addendum     = {This document contains the DOE targets of the gravimetric and volumetric methane storage capacities: 0.5 g/g and 12.5 MJ/L, respectively. 0.5 g/g = 0.5 g of methane/g adsorbent material ==> 0.5 g/g is equivalent to 100 * 0.5 g methane/(0.5 g methane + 1 g adsorbent material) = 100 * 0.5/1.5 = 33.33 wt. \%.  Hence, the gravimetric capacity target is 33.33 wt. \%.  Heating value of methane, obtained from Wikipedia: 50 MJ/kg  ==> 12.5 MJ/L is equivalent to 12.5/50 kg of methane/L = 0.25 kg of methane/L.  Hence, the volumetric capacity target is 0.25 kg/L.  0.25 kg of methane/L is equivalent to 350 cm^3 STP/cm^3:  x cm^3 STP/cm^3 = x*Mm/22.414 kg of gas/L = y kg of gas/L ==> y=x*Mm/22.414  Mm: Mass in kg of one mol of gas  Mm of CH4 = 0.01603176 kg/mol   In the case of CH4: y=x*0.01603176/22.414   y=0.25 kg/L ==> x = 0.25*22.414/0.01603176 = 349.5249429881685 cm^3 STP/cm^3 ==> x = 350 cm^3 STP/cm^3},
}

