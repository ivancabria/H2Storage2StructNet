@article{EPA+98,
   author    = {H Ebert and V Popescu and D Ahlers and
                G Sch\"utz and L Lemke and H Wende
               and P Srivastava and K  Baberschke},
   title     = {Theoretical and experimental investigations on the magnetic EXAFS at the K- and L$_{2,3}$-edges of bcc-Fe},
   journal   = epl,
   year      = {1998},
   volume    = {42},
   pages     = {295},
   addendum  = {MEXAFS, Fe, sum rules
ABSTRACT
       A fully relativistic theoretical description of magnetic EXAFS (MEXAFS) is presented that
       has been set up in the framework of relativistic multiple-scattering theory on the basis of the
       Dirac equation for spin-polarised, magnetic solids. This approach is applied to supply a
       detailed interpretation of new and very accurate experimental data for the K-and
       L-2,L-3-edges of bcc-Fe that have been recorded for photon energies up to 600 eV above the
       Fermi level. In particular it is demonstrated that the MEXAFS spectra can be interpreted on
       the basis of the so-called sum rules.
KEYWORDS PLUS
       X-RAY-ABSORPTION; CIRCULAR-DICHROISM; FINE-STRUCTURE; METALS-
}
}

@article{EPA99a,
   author    = {H Ebert and V Popescu and D Ahlers},
   title     = {A Fully Relativistic Theory For Magnetic EXAFS --
                Formalism And Applications},
   journal   = jsr,
   year      = {1999},
   volume    = {6},
   pages     = {320},
   addendum  = { A fully relativistic theory for magnetic
Extended X-ray Absorption Fine Structure (MEXAFS)
is presented that is based on the Dirac equation
for spin-polarized systems and relativistic multiple
scattering theory. This new scheme not only allows to
treat spin-polarization and all relativistic effects
on the same level but can also be applied to go beyond
the standard muffin-tin construction by using non-spherical
potentials.
Results of applications to  transition
metal as well as rare earth element systems will
be discussed in comparison with experiment.
Results of model calculations are presented meant to
support the interpretation of MEXAFS-spectra. Furthermore,
the relationship of the corresponding dichroic
MEXAFS spectra to the so-called sum-rules is discussed
MEXAFS, sum rules, Pt L2,3 in Fe3Pt}
}


