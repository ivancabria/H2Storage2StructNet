@article{KMG+99,
      author = { P Kamp and A Marty and B Gilles and R Hoffmann and
                 S Marchesini and M Belakhovsky and
                 C Boeglin and A Rogalev},
      title = { Correlation of spin and orbital anisotropies with
                chemical order in Fe$_{0.5}$Pd$_{0.5}$ alloy films using
                magnetic circular X-ray dichroism},
      journal=prb,
      volume = {59},
      pages  = {1105},
      year   = {1999},
      addendum = {The effects of chemical ordering in thin film Fe0.5Pd0.5 alloys, deposited
by molecular-beam epitaxy directly on a MgO (001) substrate, have been
studied using magnetic circular X-ray dichroism (MCXD) at the Pd and Fe L2,3
edges. This system exhibits perpendicular magnetic anisotropy if grown in
the L10 (001) phase and in-plane anisotropy in the disordered gamma phase.
We show that MCXD is a sensitive tool for studying variations in the spin
and orbital magnetic moments due to changes in the chemical order. We obtain
uantitative results for spin and orbital anisotropies and their variations
with chemical order in the Fe0.5Pd0.5 alloy system.}
}

@article{KBB+98,
      author = { P Kamp and M Belakhovsky and C Boeglin and H A Duerr
                  and G van~der~Laan and P Schill\'{e} and A Rogalev
                  and J Goulon and V Gehanno and A Marty and B Gilles},
      title = {Sensitivity of magnetic X-ray dichroism for chemical
               order in MBE-grown FePd layers},
      journal=pb,
      volume = {248},
      pages  = {127},
      year   = {1998},
      addendum = {Several thin film Fe50Pd50 binary alloys have been
 grown with MBE on a MgO(001) substrate.
 We report the effect of different degrees of chemical
 order due to different the growth temperature as measured with magnetic
 circular X-ray dichroism at the Pd L2,3 edge. We show that dichroism is a
 sensitive tool to study the modifications in the chemical order. The
 effective spin moment and orbital moment were determined using the sum rules
 for the integrated signals and exhibit comparable variations. This is the
 first evidence reported for changes in spin and orbital moments in the FePd
 system.}
}

@article{SHP+98,
      author = { M Sacchi and  C F Hague and L Pasquali and
                 A Mirone and J M Mariot and P Isberg and
                 E M Gullikson and J H  Underwood},
      title = {Optical constants of ferromagnetic iron via 2p
               resonant magnetic scattering},
      journal=prl,
      volume = {81},
      pages  = {1521},
      year   = {1998},
      addendum = {We have determined the optical constants at the 2p
 edges of iron by
 measuring the Bragg scattering from a Fe/V superlattice using elliptically
 polarized photons whose energies were tuned across the Fe 2p resonances
 (700-730 eV). The analysis of the Bragg peak displacement as a function of
 photon energy and sample magnetization, together with standard absorption
 measurements, allowed to determine the complete dielectric tensor for Fe,
 including its off-diagonal terms.}
}

@article{GMH+97,
      author= {J J Gallet and J M Mariot and C F Hague and J P Kappler
              and J Goulon and  A Rogalev and G Krill and M Sacchi and
              K Hricovini},
      title= {Valence state spin polarization in 3d-3d and 3d-4d
             magnetic materials by resonant and non-resonant X-ray emission},
      journal=jdp,
      volume = {7},
      pages  = {C2~365},
      year   = {1997},
      addendum = {Magnetic circular dichroism in X-ray fluorescence
 from ferromagnetic systems
 potentially provides unique information on valence state spin polarization.
 We discuss the use of direct polychromatic radiation from the Helios II
 helical undulator (97\% circular polarization) to excite the Rh 4d valence
 states. We also show how polychromatic radiation may be used to obtain
 dichroic resonant fluorescence under standing-wave conditions in magnetic
 multilayers.}
}


@article{HMG97,
      author= {C F Hague and J M Mariot and J J Gallet},
      title= {X-ray magnetic circular dichroism involving valence states},
      journal=apa,
      volume = {65},
      pages  = {141},
      year   = {1997},
      addendum = {Magnetic circular dichroism in
X-ray fluorescence is a probe of the spin
polarization of the occupied electron states. It can be measured under
resonant excitation conditions, i.e., by promoting an electron from a
spin-orbit split core-level to the spin-polarized empty states, or by
nonresonant excitation from such a core-level to continuum states. It is
argued that the latter method is more readily interpreted and, at least as
far as itinerant magnetism is concerned, provides valuable information
concerning the spin imbalance of the valence band as a function of energy
and with element selectivity. Experimental techniques and limitations are
also discussed.}
}

@article{GMH+96a,
      author= {J J Gallet and J M Mariot and C F Hague and J P Kappler
              and F Sirotti and M Nakazawo and H Ogasawara and A Kutani},
      title= {4d resonant inelastic X-ray scattering in gadolinium},
      journal=prb,
      volume = {54},
      pages  = {R14238},
      year   = {1996},
      addendum = {Resonant inelastic X-ray scattering (RIXS)
involving selective excitations
to Gd 4d9/5p6/4fn+1 intermediate states has been measured. An X-ray resonant
Raman effect is clearly identified for excitation to states below the 4d
ionization threshold. RIXS spectra have been calculated for several
excitation energies and provide a good quantitative explanation for the
large variation in the 5p to 4d branching ratio intensities observed as a
function of excitation energy. Weak structure observed close to the elastic
peak is identified as the result of spin-flip scattering.}
}

@article{GMH+96b,
      author= {J J Gallet and J M Mariot and C F Hague and K Hricovini
               and G Krill},
      title= {Magnetic circular dichroism observed with
             resonant X-ray fluorescence},
      journal=jesrp,
      volume = {78},
      pages  = {307},
      year   = {1996},
      addendum = {We discuss the magnetic circular dichroism observed
 in the L alpha and L
 beta X-ray fluorescence spectra of the 3d ferromagnets when excited by
 circularly polarized photons. Excitation by polychromatic photons or under
 resonance conditions (i.e., by photons tuned to the L2 or L3 threshold
 energy) are considered. We take the example of nickel to show how the X-ray
 fluorescence dichroism may be damped by L2-L3M4,5 Coster-Kronig transitions
 when the incoming photon energy is above the L2 threshold.}
}


@incollection{DGHS96,
   author    = {P J Durham and B L Gyorffy and C F Hague and P Strange},
   title     = {Magnetic circular dichroism in X-Ray fluorescence},
   booktitle = {Spin-orbit influenced spectroscopies of magnetic solids},
   year      = {1996},
   editor    = {H Ebert and G Sch\"utz},
   publisher = {Springer},
   address   = {Berlin},
   volume    = {466},
   pages     = {197},
   series    = {Lecture Notes in Physics},
   addendum  = {In this paper we discuss three recent X-ray
 fluorescence experiments from a
 unified theoretical point of view and comment on their potential usefulness
 as probes of the electronic structure in condensed matter. The first two
 will serve as an introduction to fluorescence spectroscopy involving core
 electrons of solids. They will highlight two of its features which
 distinguish it from the more well known absorption and emission
 spectroscopies. The third one deals with our principle interest, namely
 circular magnetic dichroism in fluorescence. Here, we shall focus on the
 information such experiments can yield about the magnetic correlations of
 the electrons.}
}

@article{HM95,
      author= {C F Hague and J M Mariot},
      title= { Magnetic circular dichroism in the X-ray fluorescence
           spectra of iron and a glassy-metal iron alloy},
      journal=nimprb,
      volume = {97},
      pages  = {449},
      year   = {1995},
      addendum = {
Magnetic circular dichroism (MCD) in the X-ray fluorescence of iron has been
examined using white bending magnet radiation at Super-ACO. A new
spectrometer fitted with a position sensitive detector provided data with
improved statistics compared to earlier results. The origin of a dip
observed in the L alpha dichroic signal but not in the L beta dichroic
signal is reinterpreted. As a guide to interpretation we have also measured
the MCD of glassy FeNiBMo.}
}


@article{MH94,
